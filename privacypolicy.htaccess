RewriteEngine On
RewriteBase /

# Remove trailing slash so image paths (images/...) keep working
RewriteRule ^(games|about|career|privacypolicy)/$ /$1 [R=301,L]

# Serve index.html for the single-page routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(games|about|career|privacypolicy)$ /index.html [L]
